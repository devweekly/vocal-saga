{
  "name": "vocal-saga-local-agent-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Workbuddy/OpenCode provider plus durable, versioned EPUB/PDF translation projects and CLI.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "dev": "tsx watch src/start.ts",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "doc": "tsx src/documents/cli-start.ts",
    "doc:help": "tsx src/documents/cli-start.ts --help",
    "quality:fiction-baseline": "node scripts/evaluate-fiction-quality-baseline.mjs --all"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.276",
    "express": "^5.1.0",
    "jsonrepair": "^3.15.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
