{
  "name": "vocal-saga-local-agent-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Express + TypeScript OpenAI-compatible provider backed by Workbuddy/CodeBuddy SDK or OpenCode CLI, with SQLite history.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "dev": "tsx watch src/start.ts",
    "test": "node --import tsx --test tests/server.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.276",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
