# This service defaults to 127.0.0.1 and must not be exposed to your LAN.
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=8789

# Optional. Leave empty for convenient single-user loopback use.
# For an extra local-client check, generate with: openssl rand -hex 32
# If set, enter the same value in the extension's "Local service token" field.
LOCAL_AGENT_TOKEN=

# Fallback runtime; the extension can choose either runtime per request.
LOCAL_AGENT_PROVIDER=workbuddy

# Optional model override for the local CodeBuddy/Workbuddy SDK.
# If blank, the SDK/runtime default is used. WORKBUDDY_MODEL and CODEBUDDY_DEFAULT_MODEL are fallbacks.
LOCAL_WORKBUDDY_MODEL=

# Optional OpenCode model override; if blank, OpenCode's configured default is used.
# A configured override must use provider/model, e.g. openai/gpt-5.4 or ollama/qwen3-coder.
LOCAL_OPENCODE_MODEL=

# Optional local data/timeout controls.
LOCAL_AGENT_DATA_DIR=
LOCAL_AGENT_TIMEOUT_MS=180000
# 长驻 Workbuddy 会话池：大小对齐扩展扇出；单会话复用上限（防历史变长）。
LOCAL_AGENT_POOL_SIZE=4
LOCAL_AGENT_POOL_MAX_USES=10
# 启动后后台预热池内 CLI 进程（只 boot 不调模型）；false 关闭，首单懒创建。
LOCAL_AGENT_PREWARM=true
LOCAL_AGENT_MAX_HISTORY=500
# true stores full prompts/source/output in SQLite; false stores only metadata and lengths.
LOCAL_AGENT_STORE_CONTENT=true
# On invalid model JSON, log a maximum 600-character output preview for diagnosis; set false to hide it.
LOCAL_AGENT_LOG_RESPONSE_PREVIEW=true
