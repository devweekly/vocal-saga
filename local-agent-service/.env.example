# This service defaults to 127.0.0.1 and must not be exposed to your LAN.
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=8789

# Keep this identical to the extension's "Local service token".
# Generate with: openssl rand -hex 32
LOCAL_AGENT_TOKEN=replace-with-a-long-random-token

# Fallback runtime; the extension can choose either runtime per request.
LOCAL_AGENT_PROVIDER=opencode

# Model id configured for the local CodeBuddy/Workbuddy SDK.
# WORKBUDDY_MODEL and CODEBUDDY_DEFAULT_MODEL are accepted as fallbacks.
LOCAL_WORKBUDDY_MODEL=

# OpenCode model must use provider/model format, e.g. openai/gpt-5.4 or ollama/qwen3-coder.
LOCAL_OPENCODE_MODEL=

# Optional local data/timeout controls.
LOCAL_AGENT_DATA_DIR=
LOCAL_AGENT_TIMEOUT_MS=180000
LOCAL_AGENT_MAX_HISTORY=500
# true stores full prompts/source/output in SQLite; false stores only metadata and lengths.
LOCAL_AGENT_STORE_CONTENT=true
