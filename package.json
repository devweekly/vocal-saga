{
  "name": "translation-api",
  "version": "0.5.6",
  "description": "OpenAI-compatible LLM proxy + translation service on Netlify Functions",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:cf": "npm run build:lib && wrangler dev",
    "deploy:cf": "npm run build:lib && wrangler deploy",
    "kv:create": "wrangler kv namespace create VOCAL_SAGA_KV",
    "build": "npm run build:lib",
    "build:lib": "tsc -p tsconfig.lib.json",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@mozilla/readability": "^0.6.0",
    "@netlify/blobs": "^10.7.9",
    "cheerio": "^1.2.0",
    "compromise": "^14.16.0",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "jsonrepair": "^3.15.0",
    "langsmith": "^0.10.2",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@netlify/functions": "^5.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "happy-dom": "^20.14.3",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.130.0"
  }
}
