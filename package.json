{
  "name": "translation-api",
  "version": "0.3.3",
  "description": "OpenAI-compatible LLM proxy + translation service on Netlify Functions",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:cf": "npm run build:lib && wrangler dev",
    "deploy:cf": "npm run build:lib && wrangler deploy",
    "kv:create": "wrangler kv namespace create VOCAL_SAGA_KV",
    "build": "npm run build:lib",
    "build:lib": "tsc -p tsconfig.lib.json",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "cheerio": "^1.2.0",
    "compromise": "^14.15.1",
    "hono": "^4.12.25",
    "jsdom": "^29.1.1",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "@netlify/functions": "^5.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
