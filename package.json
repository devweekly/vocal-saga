{
  "name": "translation-api",
  "version": "0.6.2",
  "description": "OpenAI-compatible LLM proxy + translation API on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "npm run build:lib && wrangler dev",
    "kv:create": "wrangler kv namespace create VOCAL_SAGA_KV",
    "build": "npm run build:lib",
    "build:lib": "tsc -p tsconfig.lib.json",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "unlock": "sh scripts/rm-git-lock.sh",
    "local-agent:install": "npm --prefix local-agent-service install",
    "local-agent:start": "npm --prefix local-agent-service start",
    "local-agent:test": "npm --prefix local-agent-service test",
    "deploy": "npm run build:lib && wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "compromise": "^14.16.0",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "jsonrepair": "^3.15.0",
    "langsmith": "^0.10.2",
    "linkedom": "^0.18.13",
    "instapaper-api": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "happy-dom": "^20.14.3",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.130.0"
  }
}
